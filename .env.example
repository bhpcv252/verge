# Servers (at least one must be enabled)
VERGE_SERVER_HTTP_ENABLED=true
VERGE_SERVER_HTTP_PORT=8080

VERGE_SERVER_GRPC_ENABLED=false
VERGE_SERVER_GRPC_PORT=9090

# PostgreSQL (always required)
VERGE_STORAGE_POSTGRES_URL=postgres://verge:changeme@postgres:5432/verge?sslmode=disable

# When enabled, every /v1 request and gRPC call requires: Authorization: Bearer <key>
VERGE_AUTH_ENABLED=false
VERGE_AUTH_KEYS=                     # comma-separated keys

# Redis (optional)
VERGE_STORAGE_REDIS_ENABLED=false
VERGE_STORAGE_REDIS_URL=
VERGE_STORAGE_REDIS_BRANCH_TTL=30s   # how long branch head entries live in cache

# Neo4j (optional)
VERGE_STORAGE_NEO4J_ENABLED=false
VERGE_STORAGE_NEO4J_URL=

# Run cmd/worker as a separate process. These vars are read by that process.
VERGE_OUTBOX_SOURCE_TYPE=polling     # polling | debezium

# Polling configuration (only used when SOURCE_TYPE=polling)
VERGE_OUTBOX_POLL_INTERVAL=500ms     # how often the worker polls outbox_events
VERGE_OUTBOX_BATCH_SIZE=100          # max events per poll cycle

# Debezium CDC configuration (only used when SOURCE_TYPE=debezium)
VERGE_OUTBOX_DEBEZIUM_BROKERS=       # e.g., "kafka:9092" or "kafka-1:9092,kafka-2:9092"
VERGE_OUTBOX_DEBEZIUM_TOPIC=verge.outbox.events
VERGE_OUTBOX_DEBEZIUM_GROUP_ID=verge-worker

# EventBus: when disabled, handlers run in-process inside the worker.
# When enabled, the worker publishes to the broker and external consumers
# run the handlers. Implement outbox.EventBus to use any broker.
VERGE_OUTBOX_EVENTBUS_ENABLED=false
VERGE_OUTBOX_EVENTBUS_TYPE=kafka     # only "kafka" is built-in; extend via code

# Kafka EventBus configuration (only read when EVENTBUS_ENABLED=true)
VERGE_KAFKA_BROKERS=kafka:9092       # comma-separated
VERGE_KAFKA_TOPIC=verge.events       # different from Debezium topic!

# OpenTelemetry Observability
# When disabled, all observability is a no-op, no exporters start.
VERGE_OTEL_ENABLED=false

# Exporter backend. Options:
#   stdout     - pretty-print spans and metrics to console (development / debug)
#   otlp       - push via gRPC to VERGE_OTEL_OTLP_ENDPOINT (Datadog, Grafana Cloud, Honeycomb, Jaeger, etc.)
#   prometheus - expose GET /metrics scrape endpoint (Prometheus / Grafana stack)
# Note: prometheus handles metrics only; traces go to stdout when this is selected.
# Use otlp if you need distributed traces and metrics together.
VERGE_OTEL_EXPORTER=stdout

# gRPC endpoint for the OTel Collector or backend. Only read when EXPORTER=otlp.
# Point this at your OTel Collector sidecar or directly at a backend that accepts OTLP.
# Example: otel-collector:4317
VERGE_OTEL_OTLP_ENDPOINT=

# Service name attached to every span, metric, and log line.
VERGE_OTEL_SERVICE_NAME=verge

# Fraction of root spans to sample. 1.0 = everything, 0.1 = 10%.
VERGE_OTEL_SAMPLE_RATE=1.0

# How often metrics are pushed to the backend. Only applies to push-based
# exporters (otlp, stdout). 
VERGE_OTEL_METRICS_INTERVAL=15s

# Minimum log level. Options: info (default) | debug
# debug emits per-storage-call logs and per-outbox-event logs
VERGE_OTEL_LOG_LEVEL=info
